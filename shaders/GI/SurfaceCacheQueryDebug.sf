#include "/Generated/ShaderParameters/SurfaceCacheQueryDebugParameters.sf"
[numthreads(8, 8, 1)]
void MainCS(uint3 thread : SV_DispatchThreadID)
{
    if (any(thread.xy >= OutputSize))
    {
        return;
    }
    uint columns = (OutputSize.x + 31u) / 32u;
    uint index = thread.y / 32u * columns + thread.x / 32u;
    float3 color = 0;
    if (index < QueryCount)
    {
        SurfaceCacheQueryResult result = Results[index];
        if ((result.Status.z & 3u) == 3u)
        {
            color = Mode == 1 ? result.NormalRoughness.xyz * 0.5 + 0.5 : result.BaseColorMetallic.rgb;
            if (Mode == 2)
            {
                uint hash = (result.Status.y + 1) * 1664525u + 1013904223u;
                color = float3(hash & 255u, (hash >> 8) & 255u, (hash >> 16) & 255u) / 255.0;
            }
        }
        else if ((result.Status.z & 1u) != 0u)
        {
            color = float3(1, 0, 1);
        }
        else if ((result.Status.z & 4u) != 0u)
        {
            color = float3(1, 0.5, 0);
        }
    }
    Output[thread.xy] = float4(color, 1);
}
