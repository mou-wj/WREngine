float2 WorldRadianceSignNotZero(float2 value)
{
    return float2(value.x < 0.0 ? -1.0 : 1.0, value.y < 0.0 ? -1.0 : 1.0);
}

float3 DecodeWorldRadianceDirection(float2 uv)
{
    float2 p = uv * 2.0 - 1.0;
    float3 n = float3(p, 1.0 - abs(p.x) - abs(p.y));
    if (n.z < 0.0)
    {
        n.xy = (1.0 - abs(n.yx)) * WorldRadianceSignNotZero(n.xy);
    }
    return normalize(n);
}

float2 EncodeWorldRadianceDirection(float3 direction)
{
    float3 n = direction / (abs(direction.x) + abs(direction.y) + abs(direction.z));
    float2 p = n.z >= 0.0 ? n.xy : (1.0 - abs(n.yx)) * WorldRadianceSignNotZero(n.xy);
    return p * 0.5 + 0.5;
}

int2 WrapWorldRadianceDirection(int2 coordinate, int size)
{
    // Each square edge folds onto itself with the other axis reversed.
    if (coordinate.x < 0 || coordinate.x >= size)
    {
        coordinate.x = clamp(coordinate.x, 0, size - 1);
        coordinate.y = size - 1 - coordinate.y;
    }
    if (coordinate.y < 0 || coordinate.y >= size)
    {
        coordinate.y = clamp(coordinate.y, 0, size - 1);
        coordinate.x = size - 1 - coordinate.x;
    }
    return coordinate;
}
