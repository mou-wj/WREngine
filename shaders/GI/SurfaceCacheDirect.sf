#include "/Generated/ShaderParameters/SurfaceCacheDirectParameters.sf"
#include "/Generated/ShaderParameters/SurfaceCacheMaterialParameters.sf"
#include "/core/ShadingCommon.sf"

float SliceVisibility(uint index, float3 position, float bias)
{
    SurfaceCacheShadowSlice slice = Shadows[index];
    float4 clip = mul(slice.ViewProjection, float4(position, 1));
    if (clip.w <= 0)
    {
        return 0;
    }
    float3 ndc = clip.xyz / clip.w;
    if (any(abs(ndc.xy) > 1.00001) || ndc.z < 0 || ndc.z > 1)
    {
        return 0; // No projected coverage must not become an unshadowed light leak.
    }
    float2 uv = ndc.xy * float2(0.5, ScreenYSign * 0.5) + 0.5;
    int2 local = min(int2(uv * float2(slice.Rect.zw)), int2(slice.Rect.zw) - 1);
    float visibility = 0;
    for (int y = -1; y <= 1; ++y)
    {
        for (int x = -1; x <= 1; ++x)
        {
            int2 pixel = int2(slice.Rect.xy) + clamp(local + int2(x, y), 0, int2(slice.Rect.zw) - 1);
            // Clear depth 1 is unoccluded. Do not use the camera CSM's clear-depth exclusion.
            float depth = ShadowAtlas.Load(int3(pixel, 0)).r;
            visibility += ndc.z - bias <= depth ? 1.0 : 0.0;
        }
    }
    return visibility / 9.0;
}

uint PointFace(float3 fromLight)
{
    float3 a = abs(fromLight);
    if (a.x >= a.y && a.x >= a.z)
    {
        return fromLight.x >= 0 ? 0 : 1;
    }
    if (a.y >= a.z)
    {
        return fromLight.y >= 0 ? 2 : 3;
    }
    return fromLight.z >= 0 ? 4 : 5;
}

[numthreads(8, 8, 1)]
void MainCS(uint3 thread : SV_DispatchThreadID)
{
    uint2 pixel = thread.xy;
    if (any(pixel >= AtlasSize))
    {
        return;
    }
    float4 surface = PositionCoverage.Load(int3(pixel, 0));
    if (surface.w <= 0.5)
    {
        Output[pixel] = 0;
        return;
    }
    float4 base = BaseColorMetallic.Load(int3(pixel, 0));
    float3 normal = normalize(NormalRoughness.Load(int3(pixel, 0)).xyz);
    float3 radiance = 0;
    // This view-independent cache excludes GGX specular, AO and emission.
    // Roughness only affects the excluded specular lobe in the current Lambert + GGX model.
    float3 diffuse = LambertDiffuse(base.rgb) * (1.0 - saturate(base.a));
    for (uint i = 0; i < LightCount; ++i)
    {
        SurfaceCacheLightData light = Lights[i];
        float3 l = -light.DirectionInnerCos.xyz;
        float attenuation = 1;
        if (light.Info.x != 0)
        {
            float3 delta = light.PositionRadius.xyz - surface.xyz;
            float distanceToLight = length(delta);
            if (distanceToLight < 1e-6 || distanceToLight >= light.PositionRadius.w)
            {
                continue;
            }
            l = delta / distanceToLight;
            attenuation = LocalLightAttenuation(distanceToLight, light.PositionRadius.w);
            if (light.Info.x == 2)
            {
                attenuation *= SpotLightAttenuation(dot(-light.DirectionInnerCos.xyz, l), light.DirectionInnerCos.w, light.ConeBias.x);
            }
        }
        float cosine = saturate(dot(normal, l));
        if (cosine <= 0 || attenuation <= 0)
        {
            continue;
        }
        float visibility = 1;
        if (light.Info.z != 0)
        {
            uint face = light.Info.x == 1 ? PointFace(surface.xyz - light.PositionRadius.xyz) : 0;
            visibility = SliceVisibility(light.Info.y + face, surface.xyz, light.ConeBias.y);
        }
        radiance += diffuse * light.ColorIntensity.rgb * light.ColorIntensity.w * attenuation * cosine * visibility;
    }
    Output[pixel] = float4(radiance, 1);
}
