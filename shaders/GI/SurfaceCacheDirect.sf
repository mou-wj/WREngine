#include "/Generated/ShaderParameters/SurfaceCacheDirectParameters.sf"
#include "/Generated/ShaderParameters/SurfaceCacheMaterialParameters.sf"
#include "/core/ShadingCommon.sf"

#include "/Generated/ShaderParameters/SurfaceCachePunctualLightParameters.sf"
#include "/GI/SurfaceCachePunctualLight.sf"

[numthreads(8, 8, 1)]
void MainCS(uint3 thread : SV_DispatchThreadID)
{
    uint2 pixel = thread.xy;
    if (any(pixel >= AtlasSize))
    {
        return;
    }
    float4 surface = PositionCoverage.Load(int3(pixel, 0));
    if (surface.w <= 0.5)
    {
        Output[pixel] = 0;
        return;
    }
    float4 base = BaseColorMetallic.Load(int3(pixel, 0));
    float3 normal = normalize(NormalRoughness.Load(int3(pixel, 0)).xyz);
    float3 radiance = 0;
    // This view-independent cache excludes GGX specular, AO and emission.
    // Roughness only affects the excluded specular lobe in the current Lambert + GGX model.
    float3 diffuse = LambertDiffuse(base.rgb) * (1.0 - saturate(base.a));
    for (uint i = 0; i < LightCount; ++i)
    {
        float3 direction;
        float3 incident = EvaluateSurfaceCacheLight(Lights[i], surface.xyz, direction);
        radiance += diffuse * incident * saturate(dot(normal, direction));
    }
    Output[pixel] = float4(radiance, 1);
}
