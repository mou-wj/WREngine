#include "/GI/SurfaceCacheCaptureCommon.sf"
SurfaceCacheCaptureVaryings MainVS(VertexFactoryInput input)
{
    VertexFactoryIntermediates value = GetVertexFactoryIntermediates(input);
    // LocalVertexFactory's general path uses LocalToWorld for normals. This capture
    // needs the inverse transpose, including nonuniform/mirrored instance transforms.
    float3 n = normalize(mul((float3x3)NormalToWorld, input.Normal));
    float3 t = float3(1, 0, 0);
    float sign = Handedness;
#if VF_SUPPORTS_TANGENT
    t = mul((float3x3)LocalToWorld, input.Tangent.xyz);
    // Some built-in mesh streams carry a zero handedness. Treat it as +1,
    // rather than generating a zero/NaN bitangent even for an untextured normal.
    sign *= input.Tangent.w < 0 ? -1 : 1;
#else
    t = cross(abs(n.z) < 0.9 ? float3(0, 0, 1) : float3(0, 1, 0), n);
#endif
    t -= n * dot(t, n);
    if (dot(t, t) < 1e-12)
    {
        t = cross(abs(n.z) < 0.9 ? float3(0, 0, 1) : float3(0, 1, 0), n);
    }
    t = normalize(t);
    value.WorldNormal = n;
    value.TangentToWorld = float3x3(t, normalize(cross(n, t)) * sign, n);
    SurfaceCacheCaptureVaryings output;
    output.Position = VertexFactoryGetClipPosition(value);
    output.FactoryInterpolants = VertexFactoryGetVSToPS(input, value);
#if VF_SUPPORTS_TANGENT
    output.FactoryInterpolants.TangentToWorld0.w = sign;
#endif
    output.FactoryInterpolants.ClipPosition = output.Position;
    return output;
}
