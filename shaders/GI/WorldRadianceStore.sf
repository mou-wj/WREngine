#include "/Generated/ShaderParameters/WorldRadianceStoreParameters.sf"
#include "/Generated/ShaderParameters/SceneEvnIBLLightParameters.sf"

[numthreads(64, 1, 1)]
void MainCS(uint3 group : SV_GroupID, uint ray : SV_GroupIndex)
{
    uint count = DirectionSize * DirectionSize;
    if (group.x >= UpdateCount || ray >= count)
    {
        return;
    }

    uint index = group.x * count + ray;
    SurfaceCacheQueryResult hit = WorldHits[index];
    SurfaceCacheLightingQueryResult lighting = WorldLighting[index];
    float3 direction = WorldQueries[index].Direction.xyz;
    float4 sample = 0.0;
    if ((hit.Status.z & 4u) == 0u)
    {
        if ((hit.Status.z & 1u) == 0u)
        {
            float3 sky = bHasEnvironment != 0u
                ? IBLSpecularMap.SampleLevel(LinearClampIBLSampler, direction, 0).rgb
                : float3(0.025, 0.035, 0.055);
            sample = float4(max(sky, 0.0), -TraceDistance);
        }
        else if ((hit.Status.z & 2u) != 0u && lighting.Radiance.a > 0.5 &&
            hit.PositionDistance.w > 0.03 && dot(hit.NormalRoughness.xyz, direction) < 0.0)
        {
            sample = float4(max(lighting.Radiance.rgb, 0.0), hit.PositionDistance.w);
        }
    }
    WorldOutput[uint2(ray, Updates[group.x].Target.x)] = sample;
}
