#include "/Generated/ShaderParameters/WorldRadianceRayLookupParameters.sf"
#include "/Generated/ShaderParameters/WorldRadianceCacheParameters.sf"
#include "/GI/WorldRadianceLookup.sf"
#if WORLD_RADIANCE_USE_VOXELS
#include "/Generated/ShaderParameters/VoxelLightingParameters.sf"
#include "/GI/VoxelLightingLookup.sf"
#endif

[numthreads(64, 1, 1)]
void MainCS(uint3 thread : SV_DispatchThreadID)
{
    uint index = thread.x;
    if (index >= QueryCount)
    {
        return;
    }

    SurfaceCacheQuery query = ScreenQueries[index];
    WorldRadianceCandidate candidate = (WorldRadianceCandidate)0;
    float prefix = 2.0 * CellSize.x;
    if (query.Control.y == 1u && query.OriginDistance.w > 2.0 * prefix)
    {
        float3 direction = normalize(query.Direction.xyz);
        float3 position = query.OriginDistance.xyz + prefix * direction;
        float remaining = query.OriginDistance.w - prefix;
#if WORLD_RADIANCE_USE_VOXELS
        candidate.RadianceLevel = LookupVoxelLighting(position, direction, remaining);
#endif
        if (candidate.RadianceLevel.w == 0.0)
        {
            candidate.RadianceLevel = LookupWorldRadiance(position, direction, remaining);
        }
        if (candidate.RadianceLevel.w > 0.0)
        {
            query.OriginDistance.w = prefix;
        }
    }
    TraceQueries[index] = query;
    CacheCandidates[index] = candidate;
}
