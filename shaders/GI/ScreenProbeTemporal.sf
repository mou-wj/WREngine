#include "/Generated/ShaderParameters/ScreenProbeTemporalParameters.sf"
#include "/Generated/ShaderParameters/GBufferInputParameters.sf"
#include "/GI/ScreenProbeGeometry.sf"

float4 ReadCurrentGeometry(int2 pixel)
{
    float depth = Depth.Load(int3(pixel, 0)).r;
    uint model = uint(GBufferC.Load(int3(pixel, 0)).b * 255.0 + 0.5);
    if (depth >= 0.999999 || model != 1u)
    {
        return float4(0, 0, 0, -1);
    }
    return float4(normalize(GBufferB.Load(int3(pixel, 0)).rgb * 2.0 - 1.0), depth);
}

float4 ReprojectHistory(float3 position, float3 normal, uint2 pixel, out float error, out float motion)
{
    error = 1.0;
    motion = 0.0;
    float4 clip = mul(PreviousViewProjection, float4(position, 1.0));
    if (clip.w <= 1e-5)
    {
        return 0.0;
    }
    float3 ndc = clip.xyz / clip.w;
    float2 uv = ndc.xy * float2(0.5, -0.5) + 0.5;
    if (any(uv < 0.0) || any(uv >= 1.0) || ndc.z < 0.0 || ndc.z >= 1.0)
    {
        return 0.0;
    }

    float2 previousPixel = uv * float2(FilterSize) - 0.5;
    motion = length((previousPixel - float2(pixel)) / float2(FilterSize));
    if (motion > 0.25)
    {
        return 0.0;
    }
    float footprint = GIPixelFootprint(previousPixel, ndc.z, FilterSize, PreviousInverseViewProjection, position);
    float planeLimit = max(0.005, 0.8 * footprint);
    float positionLimit = max(0.015, 2.2 * footprint);
    int2 base = int2(floor(previousPixel));
    float2 fraction = frac(previousPixel);
    float4 history = 0.0;
    float totalWeight = 0.0;
    [unroll]
    for (uint tap = 0; tap < 4u; ++tap)
    {
        int2 offset = int2(tap & 1u, tap >> 1u);
        int2 coord = base + offset;
        float2 axisWeight = lerp(1.0 - fraction, fraction, float2(offset));
        float weight = axisWeight.x * axisWeight.y;
        if (weight <= 1e-5 || any(coord < 0) || any(coord >= int2(FilterSize)))
        {
            continue;
        }
        float4 geometry = PreviousGeometry.Load(int3(coord, 0));
        float4 lighting = PreviousLighting.Load(int3(coord, 0));
        if (geometry.w < 0.0 || lighting.w < 1.0 || dot(normal, geometry.xyz) < 0.9)
        {
            continue;
        }
        float3 previousPosition = ReconstructGIPosition(coord, geometry.w, FilterSize, PreviousInverseViewProjection);
        float3 delta = previousPosition - position;
        float planeError = max(abs(dot(delta, normal)), abs(dot(delta, geometry.xyz))) / planeLimit;
        error = min(error, planeError);
        if (planeError > 1.0 || length(delta) > positionLimit)
        {
            continue;
        }
        history += lighting * weight;
        totalWeight += weight;
    }
    return totalWeight >= 0.25 ? history / totalWeight : 0.0;
}

void GetCurrentRange(int2 pixel, float4 geometry, float3 position, float footprint, float3 center,
    out float3 lower, out float3 upper)
{
    lower = upper = center;
    [unroll]
    for (int y = -1; y <= 1; ++y)
    {
        [unroll]
        for (int x = -1; x <= 1; ++x)
        {
            int2 coord = pixel + int2(x, y);
            if ((x == 0 && y == 0) || any(coord < 0) || any(coord >= int2(FilterSize)))
            {
                continue;
            }
            float4 neighbor = ReadCurrentGeometry(coord);
            if (neighbor.w < 0.0 || dot(neighbor.xyz, geometry.xyz) < 0.9)
            {
                continue;
            }
            float3 delta = ReconstructGIPosition(coord, neighbor.w, FilterSize, CurrentInverseViewProjection) - position;
            if (abs(dot(delta, geometry.xyz)) > max(0.005, footprint * 0.8) || length(delta) > footprint * 2.5)
            {
                continue;
            }
            float4 sample = RawGI.Load(int3(coord, 0));
            if (sample.w > 0.0)
            {
                lower = min(lower, sample.rgb);
                upper = max(upper, sample.rgb);
            }
        }
    }
}

[numthreads(8, 8, 1)]
void MainCS(uint3 thread : SV_DispatchThreadID)
{
    uint2 pixel = thread.xy;
    if (any(pixel >= FilterSize))
    {
        return;
    }

    float4 raw = RawGI.Load(int3(pixel, 0));
    float4 geometry = ReadCurrentGeometry(pixel);
    float4 lighting = float4(max(raw.rgb, 0.0), geometry.w >= 0.0 && raw.w > 0.0 ? 1.0 : 0.0);
    float error = 1.0;
    float motion = 0.0;
    float historyWeight = 0.0;
    bool bAccepted = false;
    if (bHistoryValid != 0u && lighting.w > 0.0)
    {
        float3 position = ReconstructGIPosition(pixel, geometry.w, FilterSize, CurrentInverseViewProjection);
        float4 history = ReprojectHistory(position, geometry.xyz, pixel, error, motion);
        if (history.w >= 1.0)
        {
            bAccepted = true;
            float footprint = GIPixelFootprint(pixel, geometry.w, FilterSize, CurrentInverseViewProjection, position);
            float3 lower, upper;
            GetCurrentRange(pixel, geometry, position, footprint, lighting.rgb, lower, upper);
            float currentLuma = GILuminance(lighting.rgb);
            float localVariation = GILuminance(upper - lower);
            float slack = max(0.015, max(currentLuma * 0.20, localVariation * 0.25));
            float difference = abs(GILuminance(history.rgb) - currentLuma);
            float response = 1.0 - smoothstep(slack + localVariation, 4.0 * slack + 2.0 * localVariation, difference);
            response *= lerp(1.0, 0.55, saturate(motion * 8.0));
            historyWeight = min(history.w / (history.w + 1.0), HistoryWeightLimit) * response;
            historyWeight *= lerp(0.65, 1.0, saturate(raw.w));
            float3 boundedHistory = clamp(history.rgb, max(0.0, lower - slack), upper + slack);
            lighting.rgb = lerp(lighting.rgb, boundedHistory, historyWeight);
            lighting.w = min(12.0, 1.0 + history.w * response);
        }
    }
    CurrentLighting[pixel] = lighting;
    CurrentGeometry[pixel] = geometry;

    if (FilterView != 0u)
    {
        float3 color = FilterView == 1u ? raw.rgb : lighting.rgb;
        if (FilterView == 3u)
        {
            color = bAccepted ? float3(0.05, 0.85, 0.20) : float3(0.8, 0.08, 0.06);
        }
        else if (FilterView == 4u)
        {
            color = historyWeight;
        }
        else if (FilterView == 5u)
        {
            color = float3(saturate(error), 1.0 - saturate(error), saturate(motion * 4.0));
        }
        FilterOutput[pixel] = float4(geometry.w >= 0.0 ? color : 0.0, 1.0);
    }
}
