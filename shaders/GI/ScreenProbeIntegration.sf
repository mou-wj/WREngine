#include "/Generated/ShaderParameters/ScreenProbeIntegrationParameters.sf"
#include "/Generated/ShaderParameters/GBufferInputParameters.sf"
#include "/GI/ScreenProbeGeometry.sf"

float4 EvaluateProbeIncoming(uint probeIndex, float3 surfaceNormal)
{
    ScreenProbeRecord probe = Probes[probeIndex];
    float3 probeNormal = normalize(probe.WorldNormal.xyz);
    float4 incoming = 0.0;
    [loop]
    for (uint rayIndex = 0; rayIndex < RayCount; ++rayIndex)
    {
        uint queryIndex = probeIndex * RayCount + rayIndex;
        SurfaceCacheQuery query = Queries[queryIndex];
        ScreenProbeRadianceRecord sample = Radiance[queryIndex];
        if (sample.Status.x == 0u)
        {
            continue;
        }

        float3 direction = normalize(query.Direction.xyz);
        float probeCosine = max(dot(direction, probeNormal), 1e-3);
        float surfaceCosine = max(dot(direction, surfaceNormal), 0.0);
        incoming += float4(sample.Radiance.rgb * (surfaceCosine / probeCosine), 1.0);
    }

    return incoming / max(float(RayCount), 1.0);
}

float ProbeWeight(ScreenProbeRecord probe, float3 worldPosition, float3 normal, float footprint, float spatialWeight)
{
    if (probe.Status.x == 0u)
    {
        return 0.0;
    }

    float normalAgreement = dot(normalize(probe.WorldNormal.xyz), normal);
    if (normalAgreement < 0.75)
    {
        return 0.0;
    }

    float3 separation = probe.WorldPositionDepth.xyz - worldPosition;
    float planeDistance = max(abs(dot(separation, normal)), abs(dot(separation, probe.WorldNormal.xyz)));
    float tolerance = max(0.005, footprint * 1.25);
    if (planeDistance >= tolerance || length(separation) > footprint * (1.75 * TileSize))
    {
        return 0.0;
    }
    return spatialWeight * smoothstep(0.75, 0.95, normalAgreement) * (1.0 - planeDistance / tolerance);
}

float4 ReconstructProbeIncoming(uint2 pixel, float3 worldPosition, float3 normal, float footprint)
{
    // The first sample is at TileSize / 2. The final partial tile may clamp its sample to the image edge.
    int2 baseProbe = int2(floor((float2(pixel) - float(TileSize / 2u)) / TileSize));
    float4 incoming = 0.0;
    float totalWeight = 0.0;
    [unroll]
    for (uint tap = 0; tap < 4u; ++tap)
    {
        int2 coord = clamp(baseProbe + int2(tap & 1u, tap >> 1u), int2(0, 0), int2(ProbeGridSize) - 1);
        // At a screen edge repeated clamped indices must not multiply a probe's weight.
        if (any(coord != baseProbe + int2(tap & 1u, tap >> 1u)))
        {
            continue;
        }
        uint index = uint(coord.y) * ProbeGridSize.x + uint(coord.x);
        ScreenProbeRecord probe = Probes[index];
        float2 weights = saturate(1.0 - abs(probe.ScreenPosition.xy - float2(pixel)) / TileSize);
        float weight = ProbeWeight(probe, worldPosition, normal, footprint, weights.x * weights.y);
        if (weight > 1e-5)
        {
            incoming += EvaluateProbeIncoming(index, normal) * weight;
            totalWeight += weight;
        }
    }
    if (totalWeight > 1e-5 && incoming.w > 1e-5)
    {
        return incoming / totalWeight;
    }

    // At thin surfaces or disocclusions, prefer a compatible neighbor over a zero-filled tile.
    int2 cell = int2(pixel / TileSize);
    float bestWeight = 0.0;
    float4 best = 0.0;
    [loop]
    for (int y = -1; y <= 1; ++y)
    {
        [loop]
        for (int x = -1; x <= 1; ++x)
        {
            int2 coord = cell + int2(x, y);
            if (any(coord < 0) || any(coord >= int2(ProbeGridSize)))
            {
                continue;
            }
            uint index = uint(coord.y) * ProbeGridSize.x + uint(coord.x);
            ScreenProbeRecord probe = Probes[index];
            float2 offset = (probe.ScreenPosition.xy - float2(pixel)) / TileSize;
            float weight = ProbeWeight(probe, worldPosition, normal, footprint, exp(-dot(offset, offset)));
            if (weight > bestWeight)
            {
                float4 sample = EvaluateProbeIncoming(index, normal);
                if (sample.w > 0.0)
                {
                    best = sample;
                    bestWeight = weight;
                }
            }
        }
    }
    best.w *= 0.6;
    return best;
}

[numthreads(8, 8, 1)]
void MainCS(uint3 thread : SV_DispatchThreadID)
{
    uint2 pixel = thread.xy;
    if (any(pixel >= ScreenSize))
    {
        return;
    }

    float2 uv = (float2(pixel) + 0.5) / float2(ScreenSize);
    float depth = Depth.SampleLevel(PointSampler, uv, 0).r;
    float4 gbufferA = GBufferA.SampleLevel(PointSampler, uv, 0);
    float4 gbufferB = GBufferB.SampleLevel(PointSampler, uv, 0);
    float4 gbufferC = GBufferC.SampleLevel(PointSampler, uv, 0);
    uint shadingModel = uint(gbufferC.b * 255.0 + 0.5);
    float3 normal = normalize(gbufferB.rgb * 2.0 - 1.0);
    float3 indirect = 0.0;
    float confidence = 0.0;

    if (depth < 0.999999 && shadingModel == 1u)
    {
        float3 position = ReconstructGIPosition(pixel, depth, ScreenSize, InvViewProj);
        float footprint = GIPixelFootprint(pixel, depth, ScreenSize, InvViewProj, position);
        float4 incoming = ReconstructProbeIncoming(pixel, position, normal, footprint);
        float3 diffuseReflectance = gbufferA.rgb * (1.0 - saturate(gbufferA.a));
        indirect = diffuseReflectance * saturate(gbufferC.g) * incoming.rgb;
        confidence = incoming.w;
    }

    OutputGI[pixel] = float4(indirect, bStoreConfidence != 0u ? confidence : 1.0);
    if (bWriteDebug == 0u)
    {
        return;
    }
    float4 debugColor = float4(indirect, 1.0);
    uint2 cell = pixel / TileSize;
    uint probeIndex = cell.y * ProbeGridSize.x + cell.x;
    ScreenProbeRecord probe = Probes[probeIndex];
    int2 center = int2(probe.ScreenPosition.xy);
    bool atCenter = all(abs(int2(pixel) - center) <= 1);
    if (DebugMode == 0u)
    {
        debugColor = probe.Status.x != 0u ? float4(probe.WorldNormal.xyz * 0.5 + 0.5, 1) : float4(0.35, 0.05, 0.05, 1);
        if (pixel.x % TileSize == 0 || pixel.y % TileSize == 0)
        {
            debugColor.rgb *= 0.35;
        }
    }
    else if (DebugMode == 1u && atCenter)
    {
        float3 direction = normalize(Queries[probeIndex * RayCount].Direction.xyz);
        debugColor = float4(direction * 0.5 + 0.5, 1);
    }
    else if (DebugMode == 2u && atCenter)
    {
        float hitRatio = 0.0;
        [loop]
        for (uint ray = 0; ray < RayCount; ++ray)
        {
            hitRatio += Radiance[probeIndex * RayCount + ray].Status.x != 0u ? 1.0 : 0.0;
        }
        hitRatio /= max(float(RayCount), 1.0);
        debugColor = float4(1.0 - hitRatio, hitRatio, 0.0, 1);
    }
    else if (DebugMode == 3u && atCenter)
    {
        float3 color = 0.0;
        [loop]
        for (uint ray = 0; ray < RayCount; ++ray)
        {
            color += Radiance[probeIndex * RayCount + ray].Radiance.rgb;
        }
        debugColor = float4(color / max(float(RayCount), 1.0), 1);
    }
    else if (DebugMode == 5u)
    {
        float2 cacheHits = 0.0;
        for (uint ray = 0; ray < RayCount; ++ray)
        {
            uint level = Radiance[probeIndex * RayCount + ray].Status.y;
            cacheHits += float2(level == 1u ? 1.0 : 0.0, level == 2u ? 1.0 : 0.0);
        }
        float2 ratio = cacheHits / float(RayCount);
        debugColor = float4(0.16 * (1.0 - ratio.x - ratio.y) +
            float3(0.08, 0.74, 0.98) * ratio.x + float3(0.72, 0.32, 1.0) * ratio.y, 1.0);
        if (probe.Status.x == 0u)
        {
            debugColor.rgb = 0.0;
        }
    }
    else if (DebugMode == 6u && probe.Status.x != 0u)
    {
        float3 counts = 0.0;
        for (uint ray = 0; ray < RayCount; ++ray)
        {
            uint flags = Radiance[probeIndex * RayCount + ray].Status.w;
            if ((flags & 1u) != 0u)
            {
                if ((flags & 8u) == 0u)
                {
                    counts.x += 1.0;
                }
                else if ((flags & 2u) != 0u)
                {
                    counts.y += 1.0;
                }
                else
                {
                    counts.z += 1.0;
                }
            }
        }
        debugColor = float4((counts.x * float3(1.0, 0.67, 0.08) + counts.y * float3(0.0, 0.9, 0.95) +
            counts.z * float3(0.9, 0.15, 0.75)) / float(RayCount), 1.0);
    }
    DebugOutput[pixel] = debugColor;
}
