#include "/Generated/VertexFactory.sf"

#define SHADINGMODEL_UNLIT   0
#define SHADINGMODEL_LIT 1
#include "/Generated/ShaderParameters/StaticMeshMaterialShaderPSParameters.sf"
#include "/core/MaterialParametersHelper.sf"
#if MATERIAL_SHADING_MODEL == SHADINGMODEL_LIT
#include "/core/SceneParametersHelper.sf"
#endif 

float4 MainPS(VertexFactoryVSToPS Input) : SV_Target0
{
    /*
    ===========================================================================
        Reconstruct Stable Shading Semantic
    ===========================================================================
    */

    ShadingContext Context;

    VertexFactoryFillShadingContext(
        Input,
        Context);

    /*
    ===========================================================================
        Material Evaluation
    ===========================================================================
    */

    float3 BaseColor = float3(1.0, 0.7, 0.3);

#if MATERIAL_SHADING_MODEL == SHADINGMODEL_LIT

    MaterialData Material = BuildMaterialData(Context.UV0);
    if(!HasMaterialTexture(MATERIAL_TEXTURE_NORMAL)){
        Material.NormalTS = Context.WorldNormal;
    }
    float3 Lighting = EvaluateSceneLighting(Context,Material);
    return float4(Lighting, 1.0);

#elif MATERIAL_SHADING_MODEL == SHADINGMODEL_UNLIT

    float2 uv = GetMaterialUV(Context.UV0);
    return float4(SampleBaseColor(uv) + SampleEmissive(uv), 1.0);

#else

    return float4(1, 0, 1, 1); // invalid shading model

#endif
}