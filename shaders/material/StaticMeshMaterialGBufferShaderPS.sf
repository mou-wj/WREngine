#include "/Generated/VertexFactory.sf"
#include "/core/MaterialGBufferHelper.sf"

FGBufferOutput MainPS(VSOutput input)
{
    ShadingContext context;
    VertexFactoryFillShadingContext(input.FactoryInterpolants, context);
    ApplyMaterialOpacityMask(context.UV0);
    return EvaluateMaterialGBuffer(context, 0.0, 0.0, true);
}
