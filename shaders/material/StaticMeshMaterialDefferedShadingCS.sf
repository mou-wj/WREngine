#include "/core/ShadingContext.sf"
#include "/core/ShadingCommon.sf"
#include "/Generated/ShaderParameters/GBufferTextureParameters.sf"
#if IS_IBL
#include "/core/EnvIBLParametersHelper.sf"
#else
// Scene storage buffers need early binding indices for OpenGL.
#include "/core/SceneParametersHelper.sf"
#endif
#include "/Generated/ShaderParameters/StaticMeshMaterialDefferedShadingCSParameters.sf"
#include "/core/GBufferParametersHelper.sf"

[numthreads(8,8,1)]
void MainCS(uint3 DTid : SV_DispatchThreadID)
{
    uint2 PixelPos = DTid.xy;
    if (any(PixelPos >= uint2(ScreenSize)))
    {
        return;
    }
    float2 UV = (PixelPos + 0.5) / ScreenSize;
    ShadingContext Context;
    Context.WorldPosition = ReconstructWorldPosition(UV,InvViewProj);
    Context.CameraPosition = CameraPos;
    float3 viewDir = normalize(CameraPos - Context.WorldPosition);
    Context.ViewDirection = viewDir;
    MaterialData Material = ReconstructMaterialData(UV);
    uint ShadingModelId = Material.ShadingModel;
    if (ShadingModelId > SHADINGMODEL_LIT && IsLitShadingModel(ShadingModelId))
    {
        Material.ShadingModelData = GBufferD.Load(int3(PixelPos, 0));
    }
    float3 lighting = Material.BaseColor;
    bool isLit = IsLitShadingModel(ShadingModelId);
#if IS_IBL
    float4 direct = DirectLighting.Load(int3(PixelPos, 0));
    if (isLit)
    {
        float3 normal = normalize(Material.NormalTS);
        float3 reflection = reflect(-viewDir, normal);
        float nDotV = saturate(dot(normal, viewDir));
        lighting = CalculateIBLShading(Material, normal, reflection, nDotV,
            bDeferSpecularIBL == 0u || !UsesDefaultSpecular(ShadingModelId));
    }
    OutputColor[PixelPos] = bDeferSpecularIBL == 0u || isLit ? direct + float4(lighting, 1) : direct;
#else
    if (isLit)
    {
        lighting = EvaluateSceneLighting(Context, Material);
    }
    OutputColor[PixelPos] = float4(lighting, 1);
#endif
}
