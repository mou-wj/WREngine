#include "/Generated/ShaderParameters/SceneEvnIBLLightParameters.sf"
#include "/core/ShadingCommon.sf"

float3 GetIBLFresnel(MaterialData material, float nDotV)
{
    float3 f0 = lerp(0.04.xxx, material.BaseColor, material.Metallic);
    return FresnelSchlickRoughness(nDotV, f0, material.Roughness);
}

float3 GetIBLSpecularWeight(MaterialData material, float nDotV)
{
    float2 brdf = IBLLut.SampleLevel(LinearClampIBLSampler, float2(nDotV, material.Roughness), 0).rg;
    return GetIBLFresnel(material, nDotV) * brdf.x + brdf.y;
}

float3 SampleIBLSpecular(float3 direction, float roughness)
{
    uint width, height, mipCount;
    IBLSpecularMap.GetDimensions(0, width, height, mipCount);
    return IBLSpecularMap.SampleLevel(LinearClampIBLSampler, direction, roughness * float(mipCount - 1)).rgb;
}

float3 SampleAnisotropicIBL(MaterialData material, float3 normal, float3 mirrorDirection)
{
    float anisotropy = DecodeShadingAnisotropy(material.ShadingModelData.b);
    if (anisotropy == 0.0)
    {
        return SampleIBLSpecular(mirrorDirection, material.Roughness);
    }
    float3 tangent = DecodeShadingTangent(material.ShadingModelData.rg, normal);
    float3 wideAxis = anisotropy < 0.0 ? cross(normal, tangent) : tangent;
    float3 projectedAxis = wideAxis - mirrorDirection * dot(wideAxis, mirrorDirection);
    float3 spread = projectedAxis * (abs(anisotropy) * material.Roughness);
    float narrowRoughness = material.Roughness * sqrt(1.0 - 0.5 * abs(anisotropy));
    return 0.5 * (SampleIBLSpecular(normalize(mirrorDirection - spread), narrowRoughness) +
        SampleIBLSpecular(normalize(mirrorDirection + spread), narrowRoughness));
}

float3 CalculateIBLShading(MaterialData material, float3 normal, float3 mirrorDirection, float nDotV, bool bIncludeSpecular)
{
    float3 irradiance = IBLDiffuseMap.SampleLevel(LinearClampIBLSampler, normal, 0).rgb;
    if (material.ShadingModel == SHADINGMODEL_SUBSURFACE)
    {
        float3 opposite = IBLDiffuseMap.SampleLevel(LinearClampIBLSampler, -normal, 0).rgb;
        irradiance = lerp(irradiance, opposite, material.ShadingModelData.rgb * material.ShadingModelData.a * 0.45);
    }
    float3 diffuse = irradiance * material.BaseColor;
    diffuse *= (1.0 - GetIBLFresnel(material, nDotV)) * (1.0 - material.Metallic);
    float3 lighting = diffuse;
    if (bIncludeSpecular)
    {
        float3 specular = material.ShadingModel == SHADINGMODEL_ANISOTROPIC ?
            SampleAnisotropicIBL(material, normal, mirrorDirection) : SampleIBLSpecular(mirrorDirection, material.Roughness);
        lighting += specular * GetIBLSpecularWeight(material, nDotV);
    }
    if (material.ShadingModel == SHADINGMODEL_CLEAR_COAT && material.ShadingModelData.r > 0.0)
    {
        float strength = material.ShadingModelData.r;
        float transmission = ClearCoatTransmission(nDotV, strength);
        lighting *= transmission * transmission;
        if (bIncludeSpecular)
        {
            MaterialData coat = material;
            coat.Metallic = 0.0;
            coat.Roughness = max(material.ShadingModelData.g, 0.045);
            lighting += strength * SampleIBLSpecular(mirrorDirection, coat.Roughness) * GetIBLSpecularWeight(coat, nDotV);
        }
    }
    return lighting;
}
