#include "/core/ShadingCommon.sf"
#include "/Generated/ShaderParameters/SceneShaderParameters.sf"
#include "/Generated/ShaderParameters/SceneLightParameters.sf"
#include "/core/ShadowParametersHelper.sf"


// ============================================================================
// Conversion Helpers
// Scene -> Generic Light
// ============================================================================

DirectionalLight
MakeDirectionalLight(
    DirectionalLightData Data)
{
    DirectionalLight Light;

    Light.Color =
        Data.Color;

    Light.Intensity =
        Data.Intensity;

    Light.Direction =
        normalize(
            Data.Direction);

    return Light;
}


PointLight
MakePointLight(
    PointLightData Data)
{
    PointLight Light;

    Light.Color =
        Data.Color;

    Light.Intensity =
        Data.Intensity;

    Light.Position =
        Data.Position;

    Light.Radius =
        Data.Radius;

    return Light;
}


SpotLight
MakeSpotLight(
    SpotLightData Data)
{
    SpotLight Light;

    Light.Color =
        Data.Color;

    Light.Intensity =
        Data.Intensity;

    Light.Position =
        Data.Position;

    Light.Radius =
        Data.Radius;

    Light.Direction =
        normalize(
            Data.Direction);

    Light.InnerConeCos =
        Data.InnerConeCos;

    Light.OuterConeCos =
        Data.OuterConeCos;

    return Light;
}



// ============================================================================
// Scene Lighting Evaluation
// ============================================================================

float3 EvaluateSceneLighting(
    ShadingContext Context,
    MaterialData Material)
{
    float3 Result = 0;

    // =====================================================
    // Directional
    // =====================================================

    [loop]
    for (uint i = 0;
         i < DirectionalLightCount;
         ++i)
    {
        DirectionalLightData Raw =
            DirectionalLights[i];

        DirectionalLight Light =
            MakeDirectionalLight(
                Raw);
        float3 LightShading =
            ShadeDirectionalLight(
                Context,
                Material,
                Light);
        uint lightId = Raw.LightId;
        float d = distance(Context.WorldPosition,Context.CameraPosition);
        float visibility = ComputeShadowVisibility(
            lightId, Context.WorldPosition, d, float3(0,0,0), 0);
        Result +=LightShading * visibility;

    }


    // =====================================================
    // Point
    // =====================================================

    [loop]
    for (uint i = 0;
         i < PointLightCount;
         ++i)
    {
        PointLightData Raw =
            PointLights[i];

        PointLight Light =
            MakePointLight(
                Raw);
        uint lightId = Raw.LightId;
        float visibility = ComputeShadowVisibility(
            lightId, Context.WorldPosition, 0, Light.Position, Light.Radius);
        float3 LightShading =
            ShadePointLight(
                Context,
                Material,
                Light);
        Result += LightShading * visibility;

    }
    

    // =====================================================
    // Spot
    // =====================================================

    [loop]
    for (uint i = 0;
         i < SpotLightCount;
         ++i)
    {
        SpotLightData Raw =
            SpotLights[i];

        SpotLight Light =
            MakeSpotLight(
                Raw);
        float3 LightShading =
            ShadeSpotLight(
                Context,
                Material,
                Light);
        uint lightId = Raw.LightId;
        // A light without a shadow allocation has full visibility (SHADOW_TYPE_NONE).
        float visibility = ComputeShadowVisibility(
            lightId, Context.WorldPosition, 0, Light.Position, Light.Radius);
        Result += LightShading * visibility;

    }

    // AO
    Result *=
        Material.AmbientOcclusion;

    // Emissive
    Result +=
        Material.EmissiveColor;

    return Result;
}