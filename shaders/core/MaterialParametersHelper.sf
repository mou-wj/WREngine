
#define MATERIAL_TEXTURE_BASECOLOR  (1 << 0)
#define MATERIAL_TEXTURE_OPACITY    (1 << 1)
#define MATERIAL_TEXTURE_NORMAL     (1 << 2)
#define MATERIAL_TEXTURE_ORM        (1 << 3)
#define MATERIAL_TEXTURE_EMISSIVE   (1 << 4)

#include "/Generated/ShaderParameters/MaterialShaderParameters.sf"

//=============================================================================
// Material Result Data
//=============================================================================


#include "/core/ShadingContext.sf"
#include "/core/ShadingModel.sf"

//=============================================================================
// Helper
//=============================================================================

bool HasMaterialTexture(uint Flag)
{
    return
        (TextureMask & Flag)
        != 0;
}

float2 GetMaterialUV(float2 UV)
{
    return
        UV * UVTiling
        + UVOffset;
}


//=============================================================================
// Sampling
//=============================================================================

// Pixel shaders retain implicit derivatives. Compute callers supply explicit UV gradients.
float4 SampleMaterialTexture(Texture2D texture, float2 uv, float2 uvGradientX, float2 uvGradientY)
{
#if MATERIAL_EXPLICIT_GRADIENTS
    return texture.SampleGrad(LinearWrapSampler, uv, uvGradientX, uvGradientY);
#else
    return texture.Sample(LinearWrapSampler, uv);
#endif
}

float3 SampleBaseColor(float2 UV, float2 uvGradientX = 0, float2 uvGradientY = 0)
{
    float3 Result =
        BaseColor.rgb;

    if (HasMaterialTexture(
        MATERIAL_TEXTURE_BASECOLOR))
    {
        Result *=
            SampleMaterialTexture(BaseColorTexture, UV, uvGradientX, uvGradientY).rgb;
    }

    return Result;
}

float SampleOpacity(float2 UV, float2 uvGradientX = 0, float2 uvGradientY = 0)
{
    float Result =
        Opacity;

    if (HasMaterialTexture(
        MATERIAL_TEXTURE_OPACITY))
    {
        Result *=
            SampleMaterialTexture(OpacityTexture, UV, uvGradientX, uvGradientY).r;
    }

    return Result;
}

float3 SampleEmissive(float2 UV, float2 uvGradientX = 0, float2 uvGradientY = 0)
{
    float3 Result =
        EmissiveColor;

    if (HasMaterialTexture(
        MATERIAL_TEXTURE_EMISSIVE))
    {
        Result *=
            SampleMaterialTexture(EmissiveTexture, UV, uvGradientX, uvGradientY).rgb;
    }

    return Result;
}

void SampleORM(
    float2 UV, float2 uvGradientX, float2 uvGradientY,
    out float AO,
    out float RoughnessValue,
    out float MetallicValue)
{
    AO =
        AmbientOcclusion;

    RoughnessValue =
        Roughness;

    MetallicValue =
        Metallic;

    if (HasMaterialTexture(
        MATERIAL_TEXTURE_ORM))
    {
        float3 ORM =
            SampleMaterialTexture(ORMTexture, UV, uvGradientX, uvGradientY).rgb;

        AO *= ORM.r;
        RoughnessValue *= ORM.g;
        MetallicValue *= ORM.b;
    }
}

float3 SampleNormalTS(
    float2 UV, float2 uvGradientX = 0, float2 uvGradientY = 0)
{
    float3 Result =
        float3(0, 0, 1);

    if (HasMaterialTexture(
        MATERIAL_TEXTURE_NORMAL))
    {
        Result =
            SampleMaterialTexture(NormalTexture, UV, uvGradientX, uvGradientY).xyz;

        Result =
            Result * 2.0 - 1.0;

        Result.xy *=
            NormalIntensity;

        Result =
            normalize(Result);
    }

    return Result;
}


//=============================================================================
// Build Material
//=============================================================================

MaterialData BuildMaterialData(
    float2 UV, float2 uvGradientX = 0, float2 uvGradientY = 0)
{
    MaterialData M = (MaterialData)0;
    M.ShadingModel = MATERIAL_SHADING_MODEL;
    uvGradientX *= UVTiling;
    uvGradientY *= UVTiling;

    UV =
        GetMaterialUV(UV);

    M.BaseColor =
        SampleBaseColor(UV, uvGradientX, uvGradientY);

    M.EmissiveColor =
        SampleEmissive(UV, uvGradientX, uvGradientY);

    M.Opacity =
        SampleOpacity(UV, uvGradientX, uvGradientY);

    M.OpacityMask =
        OpacityMask;

    M.Specular =
        Specular;

    SampleORM(
        UV, uvGradientX, uvGradientY,
        M.AmbientOcclusion,
        M.Roughness,
        M.Metallic);

    M.NormalTS =
        SampleNormalTS(UV, uvGradientX, uvGradientY);

#if MATERIAL_SHADING_MODEL == SHADINGMODEL_SUBSURFACE
    M.ShadingModelData = SubsurfaceTintRadius;
#endif
    return M;
}
