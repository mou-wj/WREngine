#include "/core/ShadingContext.sf"
#include "/core/ShadingModel.sf"


// ============================================================================
// Light Data
// Standalone definitions
// ============================================================================

struct DirectionalLight
{
    float3 Color;
    float  Intensity;

    float3 Direction;
};

struct PointLight
{
    float3 Color;
    float  Intensity;

    float3 Position;
    float  Radius;
};

struct SpotLight
{
    float3 Color;
    float  Intensity;

    float3 Position;
    float  Radius;

    float3 Direction;
    float  InnerConeCos;

    float  OuterConeCos;
};



// ============================================================================
// Constants
// ============================================================================

static const float PI = 3.14159265359;

float3 LambertDiffuse(float3 baseColor)
{
    return baseColor / PI;
}

float LocalLightAttenuation(float distanceToLight, float radius)
{
    float attenuation = saturate(1.0 - distanceToLight / radius);
    return attenuation * attenuation;
}

float SpotLightAttenuation(float cone, float innerCos, float outerCos)
{
    if (cone < outerCos)
    {
        return 0;
    }
    if (cone >= innerCos)
    {
        return 1;
    }
    return smoothstep(outerCos, innerCos, cone);
}



// ============================================================================
// PBR Helpers
// ============================================================================

float DistributionGGX(
    float3 N,
    float3 H,
    float Roughness)
{
    float a = Roughness * Roughness;
    float a2 = a * a;

    float NdotH = saturate(dot(N, H));
    float NdotH2 = NdotH * NdotH;

    float denom =
        NdotH2 * (a2 - 1.0) + 1.0;

    return a2 /
        max(
            PI * denom * denom,
            1e-5);
}

float GeometrySchlickGGX(
    float NdotV,
    float Roughness)
{
    float r =
        Roughness + 1.0;

    float k =
        (r * r) / 8.0;

    return NdotV /
        lerp(
            NdotV,
            1.0,
            k);
}

float GeometrySmith(
    float3 N,
    float3 V,
    float3 L,
    float Roughness)
{
    float NdotV =
        saturate(dot(N, V));

    float NdotL =
        saturate(dot(N, L));

    float ggxV =
        GeometrySchlickGGX(
            NdotV,
            Roughness);

    float ggxL =
        GeometrySchlickGGX(
            NdotL,
            Roughness);

    return ggxV * ggxL;
}

float3 FresnelSchlick(
    float CosTheta,
    float3 F0)
{
    return
        F0 +
        (1.0 - F0) *
        pow(
            1.0 - CosTheta,
            5.0);
}

float3 FresnelSchlickRoughness(
    float CosTheta,
    float3 F0,
    float Roughness)
{

    float3 F90 = max(float3(1.0 - Roughness, 1.0 - Roughness, 1.0 - Roughness), F0);
    
    return F0 + (F90 - F0) * pow(clamp(1.0 - CosTheta, 0.0, 1.0), 5.0);
}

// ============================================================================
// BRDF
// ============================================================================

float3 EvaluatePBRLighting(
    MaterialData Material,
    float3 N,
    float3 V,
    float3 L,
    float3 LightColor,
    float LightIntensity)
{
    float3 H =
        normalize(V + L);

    float NdotL =
        saturate(dot(N, L));

    float NdotV =
        saturate(dot(N, V));

    float HdotV =
        saturate(dot(H, V));

    if (NdotL <= 0.0)
    {
        return 0.0;
    }

    // Base reflectivity
    float3 F0 =
        lerp(
            0.04.xxx,
            Material.BaseColor,
            Material.Metallic);

    // BRDF terms
    float D =
        DistributionGGX(
            N,
            H,
            Material.Roughness);

    float G =
        GeometrySmith(
            N,
            V,
            L,
            Material.Roughness);

    float3 F =
        FresnelSchlick(
            HdotV,
            F0);

    // Specular
    float3 Numerator =
        D * G * F;

    float Denominator =
        max(
            4.0 * NdotV * NdotL,
            1e-5);

    float3 Specular =
        Numerator / Denominator;

    // Diffuse
    float3 KD =
        (1.0 - F) *
        (1.0 - Material.Metallic);

    float3 Diffuse =
        KD * LambertDiffuse(Material.BaseColor);

    float3 Radiance =
        LightColor *
        LightIntensity;

    return
        (Diffuse + Specular) *
        Radiance *
        NdotL;
}



float ClearCoatTransmission(float cosine, float strength)
{
    return 1.0 - strength * FresnelSchlick(saturate(cosine), 0.04.xxx).x;
}

float3 EvaluateClearCoat(MaterialData material, float3 normal, float3 view, float3 light, float3 base)
{
    float strength = material.ShadingModelData.r;
    float nDotL = saturate(dot(normal, light));
    float nDotV = saturate(dot(normal, view));
    if (strength <= 0.0 || nDotL <= 0.0 || nDotV <= 0.0)
    {
        return base;
    }

    float roughness = max(material.ShadingModelData.g, 0.045);
    float3 halfVector = normalize(view + light);
    float fresnel = FresnelSchlick(saturate(dot(halfVector, view)), 0.04.xxx).x;
    float specular = DistributionGGX(normal, halfVector, roughness) * GeometrySmith(normal, view, light, roughness) *
        fresnel / max(4.0 * nDotL * nDotV, 1e-5);
    float transmission = ClearCoatTransmission(nDotV, strength) * ClearCoatTransmission(nDotL, strength);
    return base * transmission + (strength * specular * nDotL).xxx;
}

float3 EvaluateMaterialLighting(MaterialData material, float3 normal, float3 view, float3 light,
    float3 color, float intensity)
{
    if (material.ShadingModel == SHADINGMODEL_CLEAR_COAT)
    {
        float3 base = EvaluatePBRLighting(material, normal, view, light, 1.0.xxx, 1.0);
        return EvaluateClearCoat(material, normal, view, light, base) * color * intensity;
    }

    float3 base = EvaluatePBRLighting(material, normal, view, light, color, intensity);
    if (material.ShadingModel == SHADINGMODEL_SUBSURFACE && material.ShadingModelData.a > 0.0 &&
        any(material.ShadingModelData.rgb > 0.0) && dot(normal, view) > 0.0)
    {
        float nDotL = dot(normal, light);
        float radius = material.ShadingModelData.a;
        // Normalized wrap redistributes diffuse energy towards the terminator.
        float wrapped = saturate((nDotL + radius) / (1.0 + radius)) / (1.0 + radius);
        float3 halfVector = (view + light) * rsqrt(max(dot(view + light, view + light), 1e-8));
        float3 f0 = lerp(0.04.xxx, material.BaseColor, material.Metallic);
        float3 diffuseWeight = (1.0 - FresnelSchlick(saturate(dot(halfVector, view)), f0)) * (1.0 - material.Metallic);
        float3 redistribution = material.ShadingModelData.rgb * (wrapped - saturate(nDotL));
        base += diffuseWeight * LambertDiffuse(material.BaseColor) * redistribution * color * intensity;
    }
    return base;
}

// ============================================================================
// Directional Light
// ============================================================================

float3 ShadeDirectionalLight(
    ShadingContext Context,
    MaterialData Material,
    DirectionalLight Light)
{
    float3 N =
        normalize(Material.NormalTS);

    float3 V =
        normalize(Context.ViewDirection);

    float3 L =
        normalize(-Light.Direction);

    return
        EvaluateMaterialLighting(
            Material,
            N,
            V,
            L,
            Light.Color,
            Light.Intensity);
}



// ============================================================================
// Point Light
// ============================================================================

float3 ShadePointLight(
    ShadingContext Context,
    MaterialData Material,
    PointLight Light)
{
    float3 ToLight =
        Light.Position -
        Context.WorldPosition;

    float Distance =
        length(ToLight);

    if (Distance > Light.Radius)
    {
        return 0.0;
    }

    float3 L =
        ToLight / Distance;

    float Attenuation = LocalLightAttenuation(Distance, Light.Radius);

    return
        EvaluateMaterialLighting(
            Material,
            normalize(Material.NormalTS),
            normalize(Context.ViewDirection),
            L,
            Light.Color,
            Light.Intensity *
            Attenuation);
}



// ============================================================================
// Spot Light
// ============================================================================

float3 ShadeSpotLight(
    ShadingContext Context,
    MaterialData Material,
    SpotLight Light)
{
    float3 ToLight =
        Light.Position -
        Context.WorldPosition;

    float Distance =
        length(ToLight);

    if (Distance > Light.Radius)
    {
        return 0.0;
    }

    float3 L =
        normalize(ToLight);

    float Cone =
        dot(
            normalize(-Light.Direction),
            L);
    if (Cone < Light.OuterConeCos)
    {
        return 0.0;
    }
    float Attenuation = LocalLightAttenuation(Distance, Light.Radius) *
        SpotLightAttenuation(Cone, Light.InnerConeCos, Light.OuterConeCos);

    return
        EvaluateMaterialLighting(
            Material,
            normalize(Material.NormalTS),
            normalize(Context.ViewDirection),
            L,
            Light.Color,
            Light.Intensity *
            Attenuation);
}


// ============================================================================
// 常用数学辅助
// ============================================================================

float RadicalInverse_VdC(uint bits)
{
    bits = (bits << 16) | (bits >> 16);
    bits = ((bits & 0x55555555u) << 1) | ((bits & 0xAAAAAAAAu) >> 1);
    bits = ((bits & 0x33333333u) << 2) | ((bits & 0xCCCCCCCCu) >> 2);
    bits = ((bits & 0x0F0F0F0Fu) << 4) | ((bits & 0xF0F0F0F0u) >> 4);
    bits = ((bits & 0x00FF00FFu) << 8) | ((bits & 0xFF00FF00u) >> 8);
    return float(bits) * 2.3283064365386963e-10; // 1/2^32
}

float2 Hammersley(uint i, uint N)
{
    return float2(float(i) / float(N), RadicalInverse_VdC(i));
}

float3 ImportanceSampleGGX(float2 Xi, float roughness, float3 N)
{
    float a = roughness * roughness;
    float phi = 2.0 * PI * Xi.x;
    float cosTheta = sqrt(max(0.0, (1.0 - Xi.y) / (1.0 + (a * a - 1.0) * Xi.y)));
    float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));

    float3 H;
    H.x = sinTheta * cos(phi);
    H.y = sinTheta * sin(phi);
    H.z = cosTheta;

    float3 up = abs(N.z) < 0.999 ? float3(0.0, 0.0, 1.0) : float3(1.0, 0.0, 0.0);
    float3 tangent = normalize(cross(up, N));
    float3 bitangent = cross(N, tangent);

    return normalize(tangent * H.x + bitangent * H.y + N * H.z);
}

