#include "/Generated/ShaderParameters/VirtualGeometryGPUSelectionParameters.sf"

float4 LoadSphere(uint offset, bool group)
{
    if (group)
    {
        return asfloat(uint4(SelectionGroups[offset], SelectionGroups[offset + 1],
                             SelectionGroups[offset + 2], SelectionGroups[offset + 3]));
    }
    return asfloat(uint4(SelectionClusters[offset], SelectionClusters[offset + 1],
                         SelectionClusters[offset + 2], SelectionClusters[offset + 3]));
}

float PixelError(float4 sphere, float error)
{
    float4 clip = mul(SelectionLocalToClip, float4(sphere.xyz, 1));
    float minimumW = clip.w - sphere.w * SelectionRowLengths.w;
    float perturbedW = minimumW - error * SelectionRowLengths.w;
    if (minimumW <= 0 || perturbedW <= 0 ||
        dot(SelectionNearPlane, float4(sphere.xyz, 1)) <= (sphere.w + error) * length(SelectionNearPlane.xyz))
    {
        return asfloat(0x7f800000u);
    }
    float2 maximumNDC = (abs(clip.xy) + sphere.w * SelectionRowLengths.xy) / minimumW;
    float2 pixels = error * (SelectionRowLengths.xy + maximumNDC * SelectionRowLengths.w) /
                    perturbedW * SelectionViewportSize * 0.5;
    float result = length(pixels);
    return isfinite(result) ? result : asfloat(0x7f800000u);
}

bool OutsideFrustum(float4 sphere)
{
    float4 clip = mul(SelectionLocalToClip, float4(sphere.xyz, 1));
    [unroll]
    for (uint axis = 0; axis < 3; ++axis)
    {
        float3 row = SelectionLocalToClip[axis].xyz;
        float3 wrow = SelectionLocalToClip[3].xyz;
        float upper = clip.w - clip[axis];
        float lower = axis == 2 && SelectionZeroToOne != 0 ? clip.z : clip.w + clip[axis];
        float3 lowerNormal = axis == 2 && SelectionZeroToOne != 0 ? row : wrow + row;
        // A small outward tolerance keeps tangencies under FP32 rounding conservative.
        float tolerance = 1e-5 * (1 + abs(clip.w) + abs(clip[axis]));
        if (upper < -sphere.w * length(wrow - row) - tolerance ||
            lower < -sphere.w * length(lowerNormal) - tolerance)
        {
            return true;
        }
    }
    return false;
}

[numthreads(64, 1, 1)]
void SelectGroupsCS(uint3 thread : SV_DispatchThreadID)
{
    uint work = thread.x + thread.y * (65535u * 64u);
    if (work >= SelectionWorkCount)
    {
        return;
    }
    uint group = SelectionOrder[SelectionOrderOffset + work];
    uint offset = group * VG_GROUP_WORDS;
    bool apply = SelectionTargetError > 0 && SelectionGroups[offset + 3] != 0;
    float error = asfloat(SelectionGroups[offset + 25]);
    apply = apply && PixelError(LoadSphere(offset + 21, true), error) <= SelectionTargetError;
    uint firstChild = SelectionGroups[offset], childCount = SelectionGroups[offset + 1];
    for (uint i = 0; i < childCount && apply; ++i)
    {
        uint child = SelectionChildren[firstChild + i];
        uint generator = SelectionClusters[child * VG_CLUSTER_WORDS + 5];
        if (generator != 0xffffffffu)
        {
            apply = AppliedGroups[generator].Value != 0;
        }
    }
    // Only this thread writes this Group; all generators were completed by earlier dispatches.
    AppliedGroups[group].Value = apply ? 1u : 0u;
}

#if VG_STREAMING
void EnqueueGroup(uint group, inout uint tail)
{
    if (AppliedGroups[group].Value == 0)
    {
        AppliedGroups[group].Value = 1;
        ResidencyQueue[tail++].Value = group;
    }
}

// One bounded work queue: each Group is enqueued once, no GPU-wide spin/barrier or CPU readback.
// Starting with desired coarsening, add exactly the dependencies forced by missing selected geometry.
[numthreads(1, 1, 1)]
void ResidentClosureCS()
{
    uint tail = 0;
    for (uint g = 0; g < SelectionGroupCount; ++g)
    {
        AppliedGroups[g].Value = DesiredGroups[g];
        if (DesiredGroups[g] != 0)
        {
            ResidencyQueue[tail++].Value = g;
        }
    }
    for (uint c = 0; c < SelectionClusterCount; ++c)
    {
        uint offset = c * VG_CLUSTER_WORDS;
        if (SelectionClusters[offset + 5] == 0xffffffffu && ClusterResidency[c] == 0)
        {
            EnqueueGroup(SelectionClusters[offset + 4], tail);
        }
    }
    for (uint head = 0; head < tail; ++head)
    {
        uint g = ResidencyQueue[head].Value;
        uint offset = g * VG_GROUP_WORDS;
        uint first = SelectionGroups[offset], count = SelectionGroups[offset + 1];
        for (uint i = 0; i < count; ++i)
        {
            uint child = SelectionChildren[first + i];
            uint generator = SelectionClusters[child * VG_CLUSTER_WORDS + 5];
            if (generator != 0xffffffffu)
            {
                EnqueueGroup(generator, tail); // Applying a replacement requires every generating replacement.
            }
        }
        first = SelectionGroups[offset + 2];
        count = SelectionGroups[offset + 3];
        for (uint i = 0; i < count; ++i)
        {
            uint parent = SelectionParents[first + i];
            if (ClusterResidency[parent] == 0)
            {
                EnqueueGroup(SelectionClusters[parent * VG_CLUSTER_WORDS + 4], tail);
            }
        }
    }
}

[numthreads(64, 1, 1)]
void RequestResidentPagesCS(uint3 thread : SV_DispatchThreadID)
{
    uint work = thread.x + thread.y * (65535u * 64u);
    if (work >= SelectionWorkCount)
    {
        return;
    }
    uint group = work;
    uint offset = group * VG_GROUP_WORDS;
    uint parentFirst = SelectionGroups[offset + 2], parentCount = SelectionGroups[offset + 3];
    if (parentCount == 0 || DesiredGroups[group] != 0 || AppliedGroups[group].Value == 0)
    {
        return;
    }
    for (uint p = 0; p < parentCount; ++p)
    {
        uint parent = SelectionParents[parentFirst + p];
        uint consumer = SelectionClusters[parent * VG_CLUSTER_WORDS + 4];
        if (AppliedGroups[consumer].Value != 0)
        {
            return; // Some Parent is still consumed by a coarser replacement. Never refine a partial hyperedge.
        }
    }
    uint first = SelectionGroups[offset], count = SelectionGroups[offset + 1];
    bool complete = true;
    bool request = SelectionCull == 0 || !OutsideFrustum(LoadSphere(offset + 21, true));
    for (uint i = 0; i < count; ++i)
    {
        uint child = SelectionChildren[first + i];
        bool resident = ClusterResidency[child] != 0;
        complete = complete && resident;
        if (request)
        {
            uint unused;
            InterlockedOr(StreamingFeedback[SelectionGroupCount + ClusterPages[child]].Value, resident ? 3u : 1u, unused);
        }
    }
    if (!complete && request)
    {
        uint unused;
        InterlockedOr(StreamingFeedback[group].Value, 1u, unused);
    }
}
#endif

[numthreads(64, 1, 1)]
void SelectClustersCS(uint3 thread : SV_DispatchThreadID)
{
    uint cluster = thread.x + thread.y * (65535u * 64u);
    if (cluster >= SelectionClusterCount)
    {
        return;
    }
    uint offset = cluster * VG_CLUSTER_WORDS;
    uint consumer = SelectionClusters[offset + 4], generator = SelectionClusters[offset + 5];
    bool generated = generator == 0xffffffffu;
    if (!generated)
    {
        generated = AppliedGroups[generator].Value != 0;
    }
    bool cut = generated && AppliedGroups[consumer].Value == 0;
    bool visible = cut && (SelectionCull == 0 || !OutsideFrustum(LoadSphere(offset + 14, false)));
#if VG_STREAMING
    // Root pages are pinned; closure consumes every nonresident leaf or generated Cluster before finalization.
    if (visible)
    {
        uint unused;
        InterlockedOr(StreamingFeedback[SelectionGroupCount + ClusterPages[cluster]].Value, 7u, unused);
    }
#endif
    ClusterFlags[cluster].Value = (cut ? 1u : 0u) | (visible ? 2u : 0u);
    uint triangles = SelectionClusters[offset + 3];
    // Fixed argument slots preserve the existing DrawID -> instance/resource/Cluster mapping without a CPU readback.
    uint argument = cluster * 5;
    IndirectArguments[argument].Value = visible ? triangles * 3 : 0;
    IndirectArguments[argument + 1].Value = 1;
    IndirectArguments[argument + 2].Value = SelectionClusters[offset + 2];
    IndirectArguments[argument + 3].Value = SelectionClusters[offset];
    IndirectArguments[argument + 4].Value = 0;
    uint unused;
    if (cut)
    {
        InterlockedAdd(Statistics[0].Value, 1, unused);
        if (visible)
        {
            uint slot;
            InterlockedAdd(Statistics[1].Value, 1, slot);
            VisibleClusters[slot].Value = cluster;
            InterlockedAdd(Statistics[3].Value, triangles, unused);
        }
        else
        {
            InterlockedAdd(Statistics[2].Value, 1, unused);
        }
    }
}
