struct VirtualGeometryVaryings
{
    float4 Position : SV_Position;
    nointerpolation uint DrawID : TEXCOORD0;
};
#if VERTEX_SHADER
#include "/Generated/ShaderParameters/VirtualGeometryVertexFactoryParameters.sf"
struct VirtualGeometryInput
{
    float3 Position : ATTRIBUTE0;
};
VirtualGeometryVaryings GetVirtualGeometryVertex(VirtualGeometryInput input)
