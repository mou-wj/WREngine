float3 DisplayIntegratedVolume(uint mode, float3 scattering, float4 transmittance, float3 background)
{
    if (mode == 1 || mode == 5 || mode == 8)
    {
        return scattering;
    }
    if (mode == 2)
    {
        return transmittance.rgb;
    }
    if (mode == 10)
    {
        return transmittance.w;
    }
    return scattering + transmittance.rgb * background;
}
