#include "/Generated/ShaderParameters/VolumeGridParameters.sf"

#define FroxelSize FroxelGrid.xyz
#define TileSize FroxelGrid.w
#define ScreenSize VolumeFrame.xy
#define AtlasColumns VolumeFrame.z
#define CameraPosition VolumeCameraOrigin.xyz
#define NearDistance VolumeCameraOrigin.w
#define CameraForward VolumeCameraAxis.xyz
#define FarDistance VolumeCameraAxis.w

float VolumeSliceDepth(float slice)
{
    return NearDistance * pow(FarDistance / NearDistance, slice / FroxelSize.z);
}

float3 VolumeWorldPosition(float2 pixel, float deviceDepth)
{
    float2 uv = pixel / float2(ScreenSize);
    float2 ndc = uv * float2(2, -2) + float2(-1, 1);
    float4 world = mul(InverseViewProjection, float4(ndc, deviceDepth, 1));
    return world.xyz / world.w;
}

uint2 VolumeAddress(uint3 cell, uint slab)
{
    uint slice = cell.z + slab * FroxelSize.z;
    return cell.xy + uint2(slice % AtlasColumns, slice / AtlasColumns) * FroxelSize.xy;
}

float3 VolumeFroxelCenter(uint3 cell, out float viewDepth, out float3 ray)
{
    float2 minimum = float2(cell.xy * TileSize);
    float2 maximum = min(minimum + TileSize, float2(ScreenSize));
    float2 pixel = (minimum + maximum) * 0.5;
    ray = normalize(VolumeWorldPosition(pixel, 0) - CameraPosition);
    viewDepth = VolumeSliceDepth(float(cell.z) + 0.5);
    return CameraPosition + ray * (viewDepth / max(dot(ray, CameraForward), 1e-4));
}
