#include "/Generated/ShaderParameters/VolumeCompositeParameters.sf"
#include "/volume/VolumeGrid.sf"

[numthreads(8, 8, 1)]
void MainCS(uint3 thread : SV_DispatchThreadID)
{
    uint2 pixel = thread.xy;
    if (any(pixel >= ScreenSize))
    {
        return;
    }

    float3 scattering = VolumeScattering.Load(int3(pixel, 0)).rgb;
    float3 transmittance = VolumeTransmittance.Load(int3(pixel, 0)).rgb;
    float4 background = SceneColor.Load(int3(pixel, 0));
    float3 color = scattering + transmittance * background.rgb;
    if (DrawMode == 1 || DrawMode == 5 || DrawMode == 8)
    {
        color = scattering;
    }
    else if (DrawMode == 2)
    {
        color = transmittance;
    }
    else if (DrawMode == 3)
    {
        float density = Medium.Load(int3(VolumeAddress(uint3(pixel / TileSize, DebugSlice), 0), 0)).w;
        color = 1.0 - exp(-density * 6.0);
    }
    else if (DrawMode == 4)
    {
        bool border = any(pixel % TileSize == 0);
        float sliceDepth = VolumeSliceDepth(float(DebugSlice + 1)) / FarDistance;
        color = border ? float3(0.25, 0.67, 0.92) : float3(0.05, 0.1, 0.2) * (0.4 + 0.6 * sliceDepth);
    }
    else if (DrawMode == 6)
    {
        color = VolumeDirect.Load(int3(VolumeAddress(uint3(pixel / TileSize, DebugSlice), 0), 0)).w;
    }
    else if (DrawMode == 7)
    {
        uint2 tile = pixel / TileSize;
        int2 center = int2(tile);
        int2 lower = max(center - 1, 0);
        float count = Medium.Load(int3(VolumeAddress(uint3(tile, DebugSlice), 2), 0)).w;
        float left = Medium.Load(int3(VolumeAddress(uint3(lower.x, center.y, DebugSlice), 2), 0)).w;
        float top = Medium.Load(int3(VolumeAddress(uint3(center.x, lower.y, DebugSlice), 2), 0)).w;
        color = count == 0.0 ? float3(0.02, 0.03, 0.04) : lerp(float3(0.12, 0.35, 0.75),
            float3(0.95, 0.36, 0.12), saturate((count - 1.0) * 0.5));
        if ((left != count && pixel.x % TileSize == 0) || (top != count && pixel.y % TileSize == 0))
        {
            color = float3(0.95, 0.95, 0.95);
        }
    }
    CompositeOutput[pixel] = float4(color, background.a);
}
