#include "/Generated/ShaderParameters/VolumeLightingParameters.sf"
#include "/core/ShadingCommon.sf"
#include "/volume/VolumeGrid.sf"
#include "/volume/VolumeShadow.sf"

float VolumePhase(float cosine, float anisotropy)
{
    float denominator = max(1.0 + anisotropy * anisotropy - 2.0 * anisotropy * cosine, 1e-4);
    return (1.0 - anisotropy * anisotropy) / (4.0 * PI * denominator * sqrt(denominator));
}

float3 EvaluateVolumeLight(float3 energy, float3 toLight, float3 cameraRay, float anisotropy)
{
    return max(energy, 0.0) * VolumePhase(clamp(dot(toLight, cameraRay), -1.0, 1.0), anisotropy);
}

[numthreads(4, 4, 4)]
void MainCS(uint3 cell : SV_DispatchThreadID)
{
    if (any(cell >= FroxelSize))
    {
        return;
    }
    float4 medium = Medium.Load(int3(VolumeAddress(cell, 1), 0));
    float3 light = 0.0;
    float unoccluded = 0.0, occluded = 0.0;
    if (any(medium.rgb > 0.0) && LightCount != 0)
    {
        float3 cameraRay;
        float viewDepth;
        float3 world = VolumeFroxelCenter(cell, viewDepth, cameraRay);
        [loop]
        for (uint i = 0; i < LightCount; ++i)
        {
            VolumeLightData source = SceneLights[i];
            float3 energy = source.ColorIntensity.rgb * source.ColorIntensity.w;
            float3 direction = normalize(-source.DirectionInnerCos.xyz);
            uint type = uint(source.ConeType.y);
            if (type != 0)
            {
                float3 offset = source.PositionRadius.xyz - world;
                float range = length(offset);
                if (range <= 1e-4 || range >= source.PositionRadius.w)
                {
                    continue;
                }
                float attenuation = LocalLightAttenuation(range, source.PositionRadius.w);
                float3 toLight = offset / range;
                if (type == 2)
                {
                    attenuation *= SpotLightAttenuation(dot(direction, toLight), source.DirectionInnerCos.w, source.ConeType.x);
                }
                energy *= attenuation;
                direction = toLight;
            }
            float3 contribution = EvaluateVolumeLight(energy, direction, cameraRay, medium.w);
            float weight = dot(contribution, float3(0.2126, 0.7152, 0.0722));
            if (weight > 0.0)
            {
                float visibility = VolumeShadowVisibility(source, type, world, viewDepth);
                light += contribution * visibility;
                unoccluded += weight;
                occluded += weight * visibility;
            }
        }
    }
    LightingOutput[VolumeAddress(cell, 0)] = float4(light, unoccluded > 0.0 ? occluded / unoccluded : 1.0);
}
