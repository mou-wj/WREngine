#include "/Generated/ShaderParameters/VolumeAtmosphereLight.sf"
#include "/volume/AtmosphereModel.sf"

bool IsBackgroundDepth(float depth)
{
    // The rasterized far-plane skybox can round a few float steps below the clear value.
    return depth >= 0.99999988;
}

float3 TransmittanceToSun(float3 position)
{
    float radius = max(length(position), Planet.x);
    float mu = clamp(dot(position, AtmosphereSun.xyz) / radius, -1.0, 1.0);
    float horizon = AtmosphereHorizonCosine(radius);
    if (mu < horizon)
    {
        return 0.0;
    }
    float2 uv = sqrt(saturate(float2((mu - horizon) / (1.0 - horizon), (radius - Planet.x) / Planet.y)));
    uint2 dimensions;
    AtmosphereTransmittance.GetDimensions(dimensions.x, dimensions.y);
    float2 texel = (uv * float2(dimensions - 1) + 0.5) / float2(dimensions);
    return AtmosphereTransmittance.SampleLevel(AtmosphereSampler, texel, 0).rgb;
}

float3 IntegrateAtmosphere(float3 origin, float3 ray, float maxDistance, uint steps, bool sky, bool sunDisk,
    out float3 transmittance)
{
    transmittance = 1.0;
    float2 shell;
    if (!AtmosphereSphereInterval(origin, ray, Planet.x + Planet.y, shell))
    {
        return 0.0;
    }
    float front = max(shell.x, 0.0);
    float end = min(shell.y, maxDistance);
    float2 ground;
    bool groundHit = AtmosphereSphereInterval(origin, ray, Planet.x, ground) && ground.x >= 0.0 && ground.x < end;
    end = groundHit ? ground.x : end;
    if (end <= front)
    {
        return 0.0;
    }

    float mu = clamp(dot(ray, AtmosphereSun.xyz), -1.0, 1.0);
    float rayleighPhase = 3.0 * (1.0 + mu * mu) / (16.0 * AtmospherePi);
    float g = AtmosphereAbsorption.w;
    float lobe = max(1.0 + g * g - 2.0 * g * mu, 1e-4);
    float miePhase = (1.0 - g * g) / (4.0 * AtmospherePi * lobe * sqrt(lobe));
    float start = front;
    float3 scattering = 0.0;
    [loop]
    for (uint index = 0; index < steps; ++index)
    {
        float fraction = float(index + 1) / float(steps);
        float back = lerp(start, end, fraction * fraction);
        float width = back - front;
        float3 samplePosition = origin + ray * ((front + back) * 0.5);
        float3 density = AtmosphereDensity(length(samplePosition) - Planet.x);
        float3 extinction = AtmosphereExtinction(density);
        float3 segment = exp(-extinction * width);
        float3 integral = lerp((1.0 - segment) / max(extinction, 1e-8), width * (1.0 - 0.5 * extinction * width),
            step(extinction * width, 1e-3));
        float3 source = (Rayleigh.rgb * density.x * rayleighPhase + Mie.rgb * density.y * miePhase) *
            TransmittanceToSun(samplePosition);
        scattering += transmittance * integral * source;
        transmittance *= segment;
        front = back;
    }
    if (sky && groundHit)
    {
        float3 surface = origin + end * ray;
        float sunlight = saturate(dot(normalize(surface), AtmosphereSun.xyz));
        scattering += transmittance * TransmittanceToSun(surface) * sunlight * float3(0.12, 0.11, 0.095) / AtmospherePi;
    }
    else if (sky && sunDisk)
    {
        float disk = smoothstep(0.999978, 0.999991, mu);
        scattering += transmittance * (6.0 * disk);
    }
    return scattering * AtmosphereIrradiance.rgb;
}
